{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gdm-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "gdm-web"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gdm",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./cloudflare/migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "MIGRATION_QUEUE",
        "queue": "gdm-jobs"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "71001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "CREATE_RATE_LIMITER",
      "namespace_id": "71002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "PICKER_RATE_LIMITER",
      "namespace_id": "71003",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": [
      "GOOGLE_API_KEY",
      "GOOGLE_PICKER_API_KEY",
      "GOOGLE_CLOUD_PROJECT_NUMBER",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "NEXTAUTH_SECRET",
      "TOKEN_ENCRYPTION_KEY",
      "NEXTAUTH_URL",
      "ADMIN_EMAILS"
    ]
  },
  "vars": {
    "GDM_ZERO_COST_MODE": "true",
    "GDM_DAILY_QUEUE_MESSAGE_BUDGET": "2200",
    "MAX_ACTIVE_MIGRATIONS_PER_USER": "3"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
