{
  "name": "google-drive-folder-migrator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "worker": "tsx worker.ts",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:typegen:jobs": "wrangler types --config wrangler.jobs.jsonc --env-interface CloudflareJobsEnv cloudflare-jobs-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "bullmq": "5.79.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "googleapis": "159.0.0",
    "ioredis": "5.11.1",
    "lucide-react": "0.468.0",
    "mongoose": "8.24.4",
    "next": "16.3.3",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "postcss": "8.5.23",
    "tailwindcss": "3.4.19",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "wrangler": "4.125.0"
  }
}
