{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gdm-jobs",
  "main": "cloudflare/jobs/worker.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gdm",
      "database_id": "1549ec77-9609-4976-9f60-583436a8826f",
      "migrations_dir": "./cloudflare/migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "MIGRATION_QUEUE",
        "queue": "gdm-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "gdm-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "gdm-jobs-dlq",
        "max_concurrency": 1
      }
    ]
  },
  "secrets": {
    "required": [
      "GOOGLE_API_KEY",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "TOKEN_ENCRYPTION_KEY"
    ]
  },
  "vars": {
    "GDM_ZERO_COST_MODE": "true",
    "GDM_DAILY_QUEUE_MESSAGE_BUDGET": "2200"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
